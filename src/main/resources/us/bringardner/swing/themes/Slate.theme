# A theme for the gradient look (us.bringardner.swing.gradient.Theme). Colors are #RRGGBB.
# start/end: the gradient, light to dark; text: text on the gradient; field/fieldText: text
# fields, text areas and lists; selection/selectionText: selected rows and text;
# header/headerText: table headers; accent: grid lines, outlines, scroll bars and the tree and
# sort arrows; buttonText: the text on gradient buttons; dark: true for light text on dark.
name=Slate
dark=false
start=#C3D5F2
end=#6D7D96
text=#000000
field=#FFFFFF
fieldText=#000000
selection=#6D7D96
selectionText=#FFFFFF
header=#6D7D96
headerText=#FFFFFF
accent=#6D7D96
buttonText=#FFFFFF
